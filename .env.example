# Copie este arquivo para .env e preencha os valores.
# O .env NAO deve ser versionado (ja esta no .gitignore).

# Chave secreta do Django. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria

# NUNCA deixe True em producao.
DEBUG=True

# Dominios permitidos, separados por virgula.
# Em DEBUG=True o padrao ja e localhost,127.0.0.1,[::1].
# Em producao e obrigatorio: ALLOWED_HOSTS=meusite.com,www.meusite.com
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origens confiaveis para CSRF (obrigatorio no Django 4+ sob HTTPS).
# Precisa do esquema: CSRF_TRUSTED_ORIGINS=https://meusite.com,https://www.meusite.com
CSRF_TRUSTED_ORIGINS=

# Banco de dados no formato URL.
#
# EM DESENVOLVIMENTO pode deixar em branco ou comentada: com DEBUG=True o
# Django usa um SQLite local (db.sqlite3) automaticamente, sem precisar
# instalar Postgres.
#
# EM PRODUCAO e obrigatoria (com DEBUG=False o app se recusa a subir sem ela):
#   postgres://usuario:senha@host:5432/base
#   Neon/Supabase/Vercel Postgres costumam exigir SSL:
#   postgres://usuario:senha@host/base?sslmode=require
#
# Se a senha tiver @ : / # % ou ?, use percent-encoding (@ vira %40).
# DATABASE_URL=

# Chave da API da Mistral, usada para gerar a descricao automatica dos carros.
# Se ficar vazia o cadastro continua funcionando, apenas sem descricao gerada.
MISTRAL_KEY=

# --- Conta de demonstracao -------------------------------------------------
# Preencha as DUAS variaveis para a tela de login exibir a credencial de
# demonstracao (util em portfolio). Deixe vazias e a dica nao aparece.
# A conta e criada por `python manage.py seed_demo`.
# DEMO_USER=ana.demo
# DEMO_PASSWORD=

# --- Notas de plataforma ---------------------------------------------------
# Railway e Render publicam o dominio gerado em RAILWAY_PUBLIC_DOMAIN e
# RENDER_EXTERNAL_HOSTNAME. O settings.py le essas variaveis sozinho e as
# acrescenta a ALLOWED_HOSTS e CSRF_TRUSTED_ORIGINS — voce nao precisa
# configura-las manualmente.

# Opcional: desative apenas se o proxy ja fizer o redirecionamento para HTTPS.
# SECURE_SSL_REDIRECT=True
